# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — NEVER expose this client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Elimu Finder"

# Resend (email) — https://resend.com — free 3k emails/month
RESEND_API_KEY=re_your_key

# Email sender (use a domain you own, or onboarding@resend.dev for testing)
EMAIL_FROM="Elimu Finder <noreply@elimufinder.co.ke>"
ADMIN_EMAIL=admin@elimufinder.co.ke
